# Optional overrides. Leave blank to reuse ZCode's configured provider.
MEWCODE_API_KEY=
MEWCODE_BASE_URL=
MEWCODE_MODEL=
MEWCODE_PROTOCOL=openai
# Optional path override for ZCode's provider_config.json
MEWCODE_ZCODE_CONFIG=
# Optional local session directory
MEWCODE_SESSION_DIR=
# --- Chapter 9: cross-session memory (optional overrides) ---
# Auto memory extraction frequency: extract every N new messages
MEWCODE_MEMORY_EVERY_N_MESSAGES=5
# Memory index injection limits (lines / bytes)
MEWCODE_MEMORY_INDEX_MAX_LINES=200
MEWCODE_MEMORY_INDEX_MAX_BYTES=25000
# --- Chapter 8: context management (optional overrides) ---
# Context window in tokens. Auto-compact triggers when the estimated payload
# approaches window - 20K (summary output reserve) - 13K (safety margin).
# Lower it (e.g. 30000) to see automatic compaction in action sooner.
MEWCODE_CONTEXT_WINDOW=200000
# Set to 0 / false / off to disable automatic compaction (manual /compact still works)
MEWCODE_AUTO_COMPACT=1
MEWCODE_COMPACT_SUMMARY_RESERVE=20000
MEWCODE_COMPACT_SAFETY_MARGIN=13000
# Layer 1: persist oversized tool results to disk instead of keeping them in context
MEWCODE_RESULT_MAX_CHARS=50000
MEWCODE_AGGREGATE_BUDGET_CHARS=200000
MEWCODE_RESULT_PREVIEW_CHARS=2000
